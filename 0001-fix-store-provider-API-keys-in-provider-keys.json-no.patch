 server/controllers/chat.js      |   8 ++-
 server/controllers/models.js    | 112 +++++++++++++++++++++++++-------
 server/lib/fileStore.js         |  11 +++-
 server/middleware/usageGuard.js |   8 ++-
 5 files changed, 112 insertions(+), 28 deletions(-)

